{
  "name": "newgbonhi-shop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:agent": "node scripts/dev-server.mjs",
    "api:dev": "node api/server.js",
    "api:worker:dev": "npx wrangler dev",
    "api:worker:deploy": "npx wrangler deploy",
    "build": "node scripts/generate-seo-files.js && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "products:build": "node scripts/build-products.js",
    "images:optimize": "node scripts/optimize-images.js",
    "audit:site": "node scripts/audit-site.js",
    "images:social": "node scripts/generate-social-image.js",
    "mobile:dev": "vite --mode mobile",
    "mobile:build": "node scripts/build-mobile.mjs",
    "mobile:build:preview": "node scripts/build-mobile.mjs --preview",
    "mobile:sync": "npm run mobile:build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:icons": "node scripts/generate-mobile-icons.mjs",
    "mobile:preview": "vite preview --outDir dist-mobile --port 4173",
    "mobile:apk": "node scripts/build-android-debug.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@lucide/vue": "^1.42.0",
    "csv-stringify": "^6.8.3",
    "three": "^0.186.1",
    "vue": "^3.4.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "esbuild": "^0.28.1",
    "sharp": "^0.35.1",
    "vite": "^8.0.16",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitest": "^4.1.2"
  }
}
